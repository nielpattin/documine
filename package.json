{
  "name": "@nielpattin/documine",
  "version": "1.1.3",
  "description": "Self-hosted collaborative markdown editor (pdf preview) with inline comment threads",
  "keywords": [
    "collaborative",
    "comments",
    "editor",
    "markdown",
    "pdf",
    "realtime",
    "self-hosted"
  ],
  "homepage": "https://github.com/nielpattin/documine#readme",
  "bugs": {
    "url": "https://github.com/nielpattin/documine/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nielpattin/documine.git"
  },
  "bin": {
    "documine": "cli/documine.mjs"
  },
  "files": [
    "dist/collab.js",
    "dist/code-block-style.js",
    "dist/note-archive.js",
    "dist/pdf-export.js",
    "dist/server.js",
    "apps/web/dist",
    "cli/documine.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/concurrently/dist/bin/concurrently.js \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter @documine/web dev",
    "build": "pnpm build:web && pnpm build:api",
    "build:api": "tsc",
    "build:web": "pnpm --filter @documine/web build",
    "test": "bun test",
    "lint": "node --no-warnings node_modules/oxlint/bin/oxlint -c oxlint.config.ts --tsconfig tsconfig.json --format json && node --no-warnings node_modules/oxlint/bin/oxlint -c oxlint.config.ts --tsconfig apps/web/tsconfig.json apps/web/src/ --format json",
    "lint:fix": "node --no-warnings node_modules/oxlint/bin/oxlint -c oxlint.config.ts --tsconfig tsconfig.json --fix --format json",
    "fmt": "node --no-warnings node_modules/oxfmt/bin/oxfmt -c oxfmt.config.ts --ignore-path=.gitignore --ignore-path=.git/info/exclude",
    "fmt:check": "node --no-warnings node_modules/oxfmt/bin/oxfmt -c oxfmt.config.ts --ignore-path=.gitignore --ignore-path=.git/info/exclude --check",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build",
    "release:patch": "pnpm version patch -m \"chore: release %s\" && git push origin HEAD --follow-tags",
    "release:minor": "pnpm version minor -m \"chore: release %s\" && git push origin HEAD --follow-tags",
    "release:major": "pnpm version major -m \"chore: release %s\" && git push origin HEAD --follow-tags",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "articulated": "^1.3.1",
    "concurrently": "^9.2.1",
    "hono": "^4.12.22",
    "marked": "^16.4.2",
    "mermaid": "^11.15.0",
    "puppeteer": "^24.43.1",
    "sanitize-html": "^2.17.4",
    "shiki": "^4.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
